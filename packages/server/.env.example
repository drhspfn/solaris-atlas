APP_ENV=development

# Story research worker: shared daily allowance, keys remain server-side.
AGENT_PROVIDER=responses
AGENT_MODEL=gpt-6-luna
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=
AGENT_DAILY_BUDGET_USD=1
AGENT_BUDGET_TIMEZONE=Europe/Kyiv
AGENT_DAILY_TOKEN_LIMIT=2000000
AGENT_INPUT_USD_PER_MILLION=0.10
AGENT_OUTPUT_USD_PER_MILLION=0.50
AGENT_PRICE_SAFETY_MULTIPLIER=1.25
# Optional vector indexing: text-embedding-3-small (1536 dimensions).
AGENT_EMBEDDING_MODEL=
AGENT_EMBEDDING_DIMENSIONS=1536
AGENT_EMBEDDING_INPUT_USD_PER_MILLION=0.02
# Opt-in public query embeddings require Redis; otherwise search stays lexical.
AGENT_PUBLIC_QUERY_EMBEDDINGS=false
AGENT_QUERY_REQUESTS_PER_HOUR=30
APP_NAME=WuWa Story Platform
DATABASE_URL=postgresql+asyncpg://wuwa:wuwa@localhost:5432/wuwa_story
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Full bucket root for an R2/CDN domain, without bucket suffix; leave unset for MinIO.
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
# Optional outside Compose. Use rediss:// plus credentials for a remote Redis.
# REDIS_URL=redis://localhost:6379/0
API_CACHE_NAMESPACE=solaris-api-v1
API_CACHE_TTL_SECONDS=3600
API_CACHE_MAX_BODY_BYTES=8388608
API_CACHE_TIMEOUT_SECONDS=0.3
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=wuwa
S3_REGION=us-east-1
S3_USE_SSL=false
LOG_LEVEL=INFO

# Browser authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_PENDING_REGISTRATION_TTL_MINUTES=15
AUTH_PENDING_LINK_TTL_MINUTES=10
AUTH_COOKIE_NAME=solaris_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_CSRF_COOKIE_NAME=solaris_csrf
AUTH_CSRF_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
