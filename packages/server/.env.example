APP_ENV=development
APP_NAME=WuWa Story Platform
DATABASE_URL=postgresql+asyncpg://wuwa:wuwa@localhost:5432/wuwa_story
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Full bucket root for an R2/CDN domain, without bucket suffix; leave unset for MinIO.
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
# Optional outside Compose. Use rediss:// plus credentials for a remote Redis.
# REDIS_URL=redis://localhost:6379/0
API_CACHE_NAMESPACE=solaris-api-v1
API_CACHE_TTL_SECONDS=3600
API_CACHE_MAX_BODY_BYTES=8388608
API_CACHE_TIMEOUT_SECONDS=0.3
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=wuwa
S3_REGION=us-east-1
S3_USE_SSL=false
LOG_LEVEL=INFO

# Browser authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_PENDING_REGISTRATION_TTL_MINUTES=15
AUTH_PENDING_LINK_TTL_MINUTES=10
AUTH_COOKIE_NAME=solaris_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_CSRF_COOKIE_NAME=solaris_csrf
AUTH_CSRF_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
