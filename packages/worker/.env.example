APP_ENV=development
DATABASE_URL=postgresql+asyncpg://wuwa:wuwa@localhost:5432/wuwa_story
LOG_LEVEL=INFO
RABBITMQ_URL=amqp://wuwa:wuwa@localhost:5672/
WUWA_QUEUE_CONCURRENCY=snapshot_build=1
WUWA_WORKER_WORKSPACE=./var/worker
WUWA_IMPORT_BATCH_SIZE=500
WUWA_ASSET_WORKSPACE=./var/client-assets
WUWA_ASSET_DOWNLOAD_CONCURRENCY=4
WUWA_ASSET_EXPORT_FILTERS=ConfigDB
# Windows extraction worker: absolute path to the pinned FModelCLI executable.
WUWA_FMODEL_PATH=./var/tools/FModelCLI-v1.0.2.exe
WUWA_TEXTURE_CONVERTER_PATH=./var/tools/cue-cli/cue4parse.exe
# Completed, pinned four-language voice workspace from download-voices.
WUWA_VOICE_ROOT=./var/voice-packages/VERSION-PLAN_PREFIX
WUWA_VGMSTREAM_PATH=./var/tools/.data/vgmstream-cli.exe
# Run the extraction consumer explicitly with: run --queue entity_media
# Queue map extraction after a client download (3.7.0 map readers only).
WUWA_ASSET_BUILD_MAPS=0

# Keep these model/rate settings aligned with server/.env.
# Start only the research consumer: run --queue story_agent
AGENT_PROVIDER=responses
AGENT_MODEL=gpt-6-luna
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=
AGENT_DAILY_BUDGET_USD=1
AGENT_BUDGET_TIMEZONE=Europe/Kyiv
AGENT_DAILY_TOKEN_LIMIT=2000000
AGENT_MAX_INPUT_TOKENS=250000
AGENT_MAX_TOOL_CALLS_PER_STEP=20
AGENT_INPUT_USD_PER_MILLION=0.10
AGENT_OUTPUT_USD_PER_MILLION=0.50
AGENT_PRICE_SAFETY_MULTIPLIER=1.25
AGENT_EMBEDDING_MODEL=
AGENT_EMBEDDING_DIMENSIONS=1536
AGENT_EMBEDDING_INPUT_USD_PER_MILLION=0.02
AGENT_PUBLIC_QUERY_EMBEDDINGS=false
