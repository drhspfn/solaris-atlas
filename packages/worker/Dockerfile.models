# Optional model conversion image. Build the normal worker first, then pass its
# immutable image tag/digest as WORKER_IMAGE. Production workers stay unchanged.
ARG WORKER_IMAGE
FROM ${WORKER_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils libx11-6 libxi6 libxxf86vm1 libxfixes3 libxrender1 \
    libgl1 libegl1 libsm6 libice6 libdbus-1-3 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fSL --retry 3 \
      https://download.blender.org/release/Blender4.5/blender-4.5.15-linux-x64.tar.xz \
      -o /tmp/blender.tar.xz \
    && echo '0d2b8bb2efe97e6c8eb57de6b7322f8800e1984e3125b60decca5f6771e4773e  /tmp/blender.tar.xz' | sha256sum -c - \
    && mkdir -p /app/tools/blender \
    && tar -xJf /tmp/blender.tar.xz --strip-components=1 -C /app/tools/blender \
    && rm /tmp/blender.tar.xz \
    && git init /app/tools/ueformat \
    && git -C /app/tools/ueformat fetch --depth 1 https://github.com/h4lfheart/UEFormat.git d858fe38b2b5b8c63ac4b7481b4386ebfabbf935 \
    && git -C /app/tools/ueformat checkout --detach FETCH_HEAD \
    && /app/tools/blender/blender --version \
    && find /app/tools/blender /app/tools/ueformat -type f ! -path '*/.git/*' -print0 \
       | sort -z | xargs -0 sha256sum >> /app/tools/SHA256SUMS
ENV WUWA_BLENDER_PATH=/app/tools/blender/blender \
    WUWA_UEFORMAT_PLUGIN=/app/tools/ueformat/plugins/blender
USER appuser
RUN --network=none /app/tools/blender/blender -b --factory-startup --python-exit-code 1 \
    --python-expr "import sys; sys.path.insert(0, '/app/tools/ueformat/plugins/blender'); from io_scene_ueformat.importer.import_context import UEFormatImport; print('UEFormat ready')"
