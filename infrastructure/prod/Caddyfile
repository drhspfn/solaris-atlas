{$DOMAIN} {
  encode zstd gzip

  @seo path /robots.txt /sitemap.xml
  handle @seo {
    reverse_proxy api:8000
  }

  @bot {
    header_regexp User-Agent (?i)(bot|spider|crawler|preview|discordbot|twitterbot|facebookexternalhit|googlebot|slackbot|vkshare)
    not path /api* /docs* /redoc* /openapi.json /sitemap.xml /robots.txt
  }
  handle @bot {
    rewrite * /api/seo/prerender?path={uri}
    reverse_proxy api:8000
  }

  @api path /api /api/*
  handle @api {
    uri strip_prefix /api
    reverse_proxy api:8000
  }

  @apiDocs path /docs* /redoc* /openapi.json /oauth2-redirect*
  handle @apiDocs {
    reverse_proxy api:8000
  }

  handle {
    reverse_proxy web:80
  }
}

api.{$DOMAIN} {
  encode zstd gzip
  reverse_proxy api:8000
}
