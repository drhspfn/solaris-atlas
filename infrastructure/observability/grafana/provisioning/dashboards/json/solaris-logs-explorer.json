{
  "title": "Solaris Atlas — Structured Logs (Sentry-style)",
  "uid": "solaris-logs-explorer",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(level)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "type": "textbox",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Errors & Warnings Volume",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "sum by (service, level) (count_over_time({job=~\".+\", service=~\"$service\", level=~\"ERROR|WARNING|CRITICAL\"}[1m]))", "legendFormat": "{{service}} [{{level}}]", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Errors & Tracebacks (click row for details)",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=~\".+\", service=~\"$service\", level=~\"ERROR|CRITICAL\"} |= \"$search\" | json | line_format \"[{{.level}}] [{{.service}}] {{if .message}}{{.message}}{{else}}{{.msg}}{{end}}{{if .exception_type}} — {{.exception_type}}: {{.exception_message}}{{end}}\"",
          "maxLines": 200,
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "All Service Logs (click row for JSON context)",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=~\".+\", service=~\"$service\", level=~\"$level\"} |= \"$search\" | json | line_format \"[{{.level}}] [{{.service}}] {{if .request_method}}{{.request_method}} {{.request_uri}} [{{.status}}]{{else if .message}}{{.message}}{{else if .msg}}{{.msg}}{{end}}{{if .exception_type}} — {{.exception_type}}: {{.exception_message}}{{end}}\"",
          "maxLines": 200,
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    }
  ]
}
